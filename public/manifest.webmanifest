{
  "name": "PakkaQR — QR codes that work",
  "short_name": "PakkaQR",
  "description": "Free QR codes that never expire. No signup, no tracking, no watermark.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F4EFE6",
  "theme_color": "#F4EFE6",
  "lang": "en",
  "categories": ["utilities", "productivity"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "shortcuts": [
    {
      "name": "Make a QR code",
      "short_name": "Create",
      "url": "./"
    },
    {
      "name": "Scan a QR code",
      "short_name": "Scan",
      "url": "./qr-code-scanner"
    },
    {
      "name": "Barcode generator",
      "short_name": "Barcode",
      "url": "./barcode-generator"
    }
  ]
}
