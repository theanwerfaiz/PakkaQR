# All optional. Copy to .env for local builds, or set them on your host.
PUBLIC_SITE_URL=https://pakkaqr.pages.dev
# Sub-path when hosted below the domain root, e.g. /PakkaQR/ for GitHub project pages.
PUBLIC_BASE_PATH=/
PUBLIC_GITHUB_URL=https://github.com/theanwerfaiz/PakkaQR
PUBLIC_SPONSOR_URL=
PUBLIC_UPI_DONATE_ID=
# Optional, OFF by default. Only a self-hosted, cookieless analytics endpoint on your own domain.
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_ANALYTICS_PATH=/api/hit
