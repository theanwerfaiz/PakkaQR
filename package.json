{
  "name": "pakkaqr",
  "version": "0.1.0",
  "private": true,
  "description": "Free, open-source QR code generator. Codes never expire. No signup, no tracking, runs in your browser.",
  "license": "MIT",
  "author": "Faiz Anwer",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-assets.mjs",
    "build": "astro build && node scripts/build-sw.mjs",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "7.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@zxing/library": "0.23.0",
    "astro": "7.3.5",
    "idb-keyval": "6.3.0",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "jszip": "3.10.2",
    "papaparse": "5.7.0",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "svg2pdf.js": "2.8.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.4",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
