---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/noto-sans-devanagari/devanagari-400.css';
import '@fontsource/noto-sans-devanagari/devanagari-700.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import {
  defaultLocale,
  localeInfo,
  localePath,
  locales,
  getTranslator,
  type Locale,
} from '../lib/i18n';
import { siteConfig, withBase } from '../lib/site';

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  /** Pages without a translation (404) skip hreflang. */
  alternates?: boolean;
  ogImage?: string;
}

const {
  locale,
  slug,
  title,
  description,
  jsonLd = [],
  noindex = false,
  alternates = true,
  ogImage,
} = Astro.props;
const t = getTranslator(locale);
const base = import.meta.env.BASE_URL;
const site = Astro.site ?? new URL('https://pakkaqr.pages.dev');
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(localePath(locale, slug, base));
const og = abs(ogImage ?? withBase(`og/${slug || 'home'}-${locale}.png`));
const info = localeInfo[locale];
const ldJson = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={info.tag} dir={info.dir} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {alternates &&
      locales.map((l) => (
        <link rel="alternate" hreflang={localeInfo[l].tag} href={abs(localePath(l, slug, base))} />
      ))}
    {alternates && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={abs(localePath(defaultLocale, slug, base))}
      />
    )}
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#1F6FEB" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={withBase('icons/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('icons/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('manifest.webmanifest')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PakkaQR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'hi' ? 'hi_IN' : 'en_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script is:inline src={withBase('theme.js')}></script>
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={ldJson(data)} />
    ))}
  </head>
  <body
    class="flex min-h-screen flex-col"
    data-base={base}
    data-sw={withBase('sw.js')}
    data-analytics={siteConfig.analyticsEnabled ? withBase(siteConfig.analyticsPath) : undefined}
    data-install-text={t('install.prompt')}
    data-install-yes={t('install.install')}
    data-install-no={t('install.dismiss')}
  >
    <Header locale={locale} slug={slug} />
    <main id="main" class="flex-1" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
