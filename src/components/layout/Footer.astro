---
import { localePath, getTranslator, type Locale } from '../../lib/i18n';
import { siteConfig } from '../../lib/site';
import { UPI_VPA_RE } from '../../lib/payloads/upi';
import { NAV } from '../../data/pages';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslator(locale);
const base = import.meta.env.BASE_URL;
const href = (slug: string) => localePath(locale, slug, base);
const year = new Date().getFullYear();
// Dog-fooding: the same UPI payment link a PakkaQR UPI code would hold.
// The UPI ID goes in raw (like our encoder), so it must be a valid ID.
const upiId = UPI_VPA_RE.test(siteConfig.upiDonateId) ? siteConfig.upiDonateId : '';
const upiDonateLink = `upi://pay?pa=${upiId}&pn=PakkaQR&tn=${encodeURIComponent('PakkaQR donation')}&cu=INR`;
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto grid max-w-[1360px] gap-10 px-4 py-14 sm:grid-cols-2 sm:px-8 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div class="flex flex-col gap-3">
      <p class="text-[1.6rem] leading-none font-[750] [font-stretch:80%]" lang="en">
        Pakka<span class="font-normal">QR</span>
      </p>
      <p class="max-w-[34ch] text-muted">{t('footer.tagline')}</p>
      <p class="kicker">{t('footer.promise')}</p>
    </div>
    <nav aria-labelledby="footer-tools">
      <h2 id="footer-tools" class="kicker !text-[0.75rem] !font-normal">
        {t('footer.tools')}
      </h2>
      <ul class="mt-3 space-y-2">
        <li>
          <a href={href(NAV.generator)}>{t('nav.generator')}</a>
        </li>
        <li>
          <a href={href(NAV.batch)}>{t('nav.batch')}</a>
        </li>
        <li>
          <a href={href(NAV.scanner)}>{t('nav.scanner')}</a>
        </li>
        <li>
          <a href={href(NAV.expiry)}>{t('nav.expiry')}</a>
        </li>
        <li>
          <a href={href(NAV.print)}>{t('nav.print')}</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-learn">
      <h2 id="footer-learn" class="kicker !text-[0.75rem] !font-normal">
        {t('footer.learn')}
      </h2>
      <ul class="mt-3 space-y-2">
        <li>
          <a href={href('static-vs-dynamic-qr-codes')}>{t('footer.staticVsDynamic')}</a>
        </li>
        <li>
          <a href={href('faq')}>{t('footer.faq')}</a>
        </li>
        <li>
          <a href={href('privacy')}>{t('footer.privacy')}</a>
        </li>
        <li>
          <a href={href('about')}>{t('footer.about')}</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-project">
      <h2 id="footer-project" class="kicker !text-[0.75rem] !font-normal">
        {t('footer.project')}
      </h2>
      <ul class="mt-3 space-y-2">
        <li>
          <a href={siteConfig.githubUrl} rel="noopener">
            {t('footer.source')}
          </a>
        </li>
        {upiId && (
          <li>
            <a href={upiDonateLink}>{t('footer.upiDonate')}</a>
          </li>
        )}
        {siteConfig.sponsorUrl && (
          <li>
            <a href={siteConfig.sponsorUrl} rel="noopener">
              {t('footer.sponsor')}
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-[1360px] px-4 py-5 text-sm text-muted sm:px-8">
      © {year} PakkaQR · MIT License · {t('footer.trademark')}
    </p>
  </div>
</footer>
