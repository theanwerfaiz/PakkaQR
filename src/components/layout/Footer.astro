---
import { localePath, getTranslator, type Locale } from '../../lib/i18n';
import { siteConfig } from '../../lib/site';
import { NAV } from '../../data/pages';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslator(locale);
const base = import.meta.env.BASE_URL;
const href = (slug: string) => localePath(locale, slug, base);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-border bg-surface">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-bold">PakkaQR</p>
      <p class="mt-1 text-sm text-muted">{t('brand.tagline')}</p>
      <p class="mt-3 text-sm text-muted">{t('footer.tagline')}</p>
    </div>
    <nav aria-labelledby="footer-tools">
      <h2 id="footer-tools" class="text-sm font-semibold">
        {t('footer.tools')}
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        <li>
          <a href={href(NAV.generator)}>{t('nav.generator')}</a>
        </li>
        <li>
          <a href={href(NAV.batch)}>{t('nav.batch')}</a>
        </li>
        <li>
          <a href={href(NAV.scanner)}>{t('nav.scanner')}</a>
        </li>
        <li>
          <a href={href(NAV.expiry)}>{t('nav.expiry')}</a>
        </li>
        <li>
          <a href={href(NAV.print)}>{t('nav.print')}</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-learn">
      <h2 id="footer-learn" class="text-sm font-semibold">
        {t('footer.learn')}
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        <li>
          <a href={href('static-vs-dynamic-qr-codes')}>{t('footer.staticVsDynamic')}</a>
        </li>
        <li>
          <a href={href('faq')}>{t('footer.faq')}</a>
        </li>
        <li>
          <a href={href('privacy')}>{t('footer.privacy')}</a>
        </li>
        <li>
          <a href={href('about')}>{t('footer.about')}</a>
        </li>
      </ul>
    </nav>
    <nav aria-labelledby="footer-project">
      <h2 id="footer-project" class="text-sm font-semibold">
        {t('footer.project')}
      </h2>
      <ul class="mt-2 space-y-1 text-sm">
        <li>
          <a href={siteConfig.githubUrl} rel="noopener">
            {t('footer.source')}
          </a>
        </li>
        {siteConfig.sponsorUrl && (
          <li>
            <a href={siteConfig.sponsorUrl} rel="noopener">
              {t('footer.sponsor')}
            </a>
          </li>
        )}
      </ul>
    </nav>
  </div>
  <div class="border-t border-border">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-muted">
      © {year} PakkaQR · MIT License · {t('footer.trademark')}
    </p>
  </div>
</footer>
