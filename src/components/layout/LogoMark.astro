---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 34 34" aria-hidden="true" focusable="false">
  <rect
    x="1.5"
    y="1.5"
    width="31"
    height="31"
    rx="7"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
  ></rect>
  <rect x="7" y="7" width="8" height="8" rx="1.5" fill="currentColor"></rect>
  <rect x="19" y="7" width="8" height="8" rx="1.5" fill="currentColor"></rect>
  <rect x="7" y="19" width="8" height="8" rx="1.5" fill="currentColor"></rect>
  <circle cx="23" cy="23" r="5" fill="var(--stamp)"></circle>
</svg>
