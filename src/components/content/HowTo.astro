---
interface Props {
  title: string;
  steps: string[];
}
const { title, steps } = Astro.props;
---

<section class="mx-auto mt-14 max-w-6xl px-4" aria-labelledby="howto-heading">
  <h2 id="howto-heading">{title}</h2>
  <ol class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((step, i) => (
      <li class="card flex gap-3 p-4">
        <span
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent font-bold text-accent-contrast"
          aria-hidden="true"
        >
          {i + 1}
        </span>
        <span>{step}</span>
      </li>
    ))}
  </ol>
</section>
