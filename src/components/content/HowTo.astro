---
interface Props {
  title: string;
  steps: string[];
}
const { title, steps } = Astro.props;
---

<section class="mx-auto mt-20 max-w-[1360px] px-4 sm:px-8" aria-labelledby="howto-heading">
  <h2 id="howto-heading">{title}</h2>
  <ol class="mt-8 grid gap-x-8 gap-y-8 border-t border-border pt-8 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((step, i) => (
      <li class="flex flex-col gap-3">
        <span class="font-mono text-sm text-stamp" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span class="text-[1.1rem]">{step}</span>
      </li>
    ))}
  </ol>
</section>
