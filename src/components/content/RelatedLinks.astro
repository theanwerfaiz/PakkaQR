---
import { pageBySlug } from '../../data/pages';
import { localePath, type Locale } from '../../lib/i18n';
import { useContent } from '../../lib/i18n/content';
interface Props {
  locale: Locale;
  slugs: string[];
  title: string;
}
const { locale, slugs, title } = Astro.props;
const c = useContent(locale);
const base = import.meta.env.BASE_URL;
const links = slugs
  .map((slug) => pageBySlug.get(slug))
  .filter((p) => p !== undefined)
  .map((p) => ({
    href: localePath(locale, p.slug, base),
    label: c(`pages.${p.key}.linkText`),
    blurb: c(`pages.${p.key}.blurb`),
  }));
---

<nav class="mx-auto mt-20 max-w-[1360px] px-4 sm:px-8" aria-labelledby="related-heading">
  <h2 id="related-heading">{title}</h2>
  <ul class="mt-6 grid gap-x-8 border-t border-border sm:grid-cols-2 lg:grid-cols-3">
    {links.map((l) => (
      <li class="border-b border-border">
        <a href={l.href} class="group block h-full py-5 no-underline">
          <span class="text-[1.2rem] font-semibold text-text group-hover:text-stamp">
            {l.label}
          </span>
          <span class="mt-1 block text-muted">{l.blurb}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
