---
import Icon from '../layout/Icon.astro';
import { NAV, TOOL_SLUGS } from '../../data/pages';
import { getTranslator, localePath, type Locale } from '../../lib/i18n';
import { barcodeSvg, defaultBarcodeStyle, encodeBarcode, layoutBarcode } from '../../lib/barcode';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getTranslator(locale);
const base = import.meta.env.BASE_URL;
const link = (slug: string) => localePath(locale, slug, base);

// A real, valid EAN-13 drawn by the same encoder the barcode tool uses.
const ean = encodeBarcode('ean13', '890123456789');
const eanSvg = ean.ok
  ? barcodeSvg(
      layoutBarcode('ean13', ean, defaultBarcodeStyle),
      { ...defaultBarcodeStyle, fg: '#1A1712', bg: '#FFFFFF' },
      'EAN-13 8901234567890',
      3,
    )
  : '';

const tiles = [
  { id: 'barcode', slug: TOOL_SLUGS.barcode, icon: 'barcode', span: 'lg:col-span-2' },
  { id: 'secret', slug: TOOL_SLUGS.secret, icon: 'lock', span: '' },
  { id: 'photo', slug: TOOL_SLUGS.photo, icon: 'image', span: '' },
  { id: 'templates', slug: TOOL_SLUGS.templates, icon: 'layers', span: 'lg:col-span-2' },
  { id: 'numbered', slug: `${NAV.batch}#numbered`, icon: 'table', span: '' },
  { id: 'scanner', slug: NAV.scanner, icon: 'scan', span: '' },
  { id: 'expiry', slug: NAV.expiry, icon: 'clock', span: '' },
  { id: 'print', slug: NAV.print, icon: 'print', span: '' },
  { id: 'batch', slug: NAV.batch, icon: 'stack', span: 'lg:col-span-2' },
];
---

<section class="mx-auto mt-24 max-w-[1360px] px-4 sm:px-8" aria-labelledby="bento-heading">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 id="bento-heading" class="max-w-[16ch] !text-[clamp(2rem,1.4rem+2.4vw,3.25rem)]">
      {t('bento.title')}
    </h2>
    <p class="max-w-[38ch] text-muted">{t('bento.lead')}</p>
  </div>
  <ul class="mt-8 grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {tiles.map((tile) => (
      <li class={tile.span}>
        <a
          href={link(tile.slug)}
          class:list={[
            'group flex h-full min-h-[280px] flex-col gap-4 rounded-[24px] p-6 no-underline shadow-[var(--shadow-card)] transition-transform hover:-translate-y-1',
            tile.id === 'scanner'
              ? 'bg-[#141210] text-[#EFE8DA] hover:text-[#EFE8DA]'
              : 'bg-surface text-text hover:text-text',
          ]}
          data-bento={tile.id}
        >
          <span
            class:list={[
              'flex items-center gap-2',
              tile.id === 'scanner' ? 'text-[#B9AE99]' : 'text-muted',
            ]}
          >
            <Icon name={tile.icon} size={18} />
            <span class:list={['kicker', tile.id === 'scanner' && '!text-[#B9AE99]']}>
              {t(`tools.${tile.id}.name`)}
            </span>
          </span>
          <span class="flex flex-1 items-center justify-center" aria-hidden="true">
            {tile.id === 'barcode' && (
              <span
                class="block w-full max-w-[300px] rounded-[12px] bg-white px-4 pt-3 pb-1 [&>svg]:h-auto [&>svg]:w-full"
                set:html={eanSvg}
              />
            )}
            {tile.id === 'secret' && (
              <span class="flex flex-col items-center gap-2">
                <span class="flex h-16 w-16 items-center justify-center rounded-[18px] bg-accent text-accent-contrast">
                  <Icon name="lock" size={30} />
                </span>
                <code class="font-mono text-xs text-muted">pq1:Xk9fQ2…a7Q</code>
              </span>
            )}
            {tile.id === 'photo' && (
              <span class="relative block h-36 w-36 overflow-hidden rounded-[16px] bg-[radial-gradient(circle_at_30%_30%,#F0A35E,#C2321A_55%,#4A1F44)]">
                <span class="absolute inset-3 grid grid-cols-7 gap-[3px] opacity-90">
                  {Array.from({ length: 49 }, (_, i) => (
                    <span
                      class:list={[
                        'rounded-[2px]',
                        (i * 7 + (i % 5)) % 3 === 0 ? 'bg-[#1A1712]' : 'bg-[#FFFCF6]/80',
                      ]}
                    />
                  ))}
                </span>
              </span>
            )}
            {tile.id === 'templates' && (
              <span class="flex gap-2 sm:gap-3">
                {[
                  ['#1C1915', '#EFE8DA'],
                  ['#FAF0F7', '#4A1F44'],
                  ['#E3E8F6', '#20345E'],
                  ['#C2321A', '#FFFCF6'],
                ].map(([bg, fg], i) => (
                  <span
                    class:list={[
                      'flex h-36 w-24 flex-col items-center justify-center gap-2 rounded-[14px] shadow-[0_12px_20px_-14px_rgb(0_0_0/0.5)]',
                      i > 2 && 'max-sm:hidden',
                    ]}
                    style={`background:${bg};color:${fg}`}
                  >
                    <span class="grid h-12 w-12 grid-cols-3 gap-[2px] rounded-[4px] bg-white p-1">
                      {Array.from({ length: 9 }, (_, j) => (
                        <span class:list={[j % 2 === 0 ? 'bg-[#1A1712]' : 'bg-transparent']} />
                      ))}
                    </span>
                    <span class="text-[0.7rem] font-bold">{t(`bento.templateLabels.${i}`)}</span>
                  </span>
                ))}
              </span>
            )}
            {tile.id === 'numbered' && (
              <span class="relative block h-32 w-36">
                {['01', '02', '03'].map((n, i) => (
                  <span
                    class="absolute flex h-24 w-24 flex-col items-center justify-center gap-1 rounded-[12px] bg-surface shadow-[0_8px_16px_-10px_rgb(0_0_0/0.45)]"
                    style={`left:${i * 16}px;top:${i * 12}px`}
                  >
                    <Icon name="qr" size={34} />
                    <span class="font-mono text-[0.7rem]">TABLE {n}</span>
                  </span>
                ))}
              </span>
            )}
            {tile.id === 'scanner' && (
              <span class="flex w-full flex-col gap-2">
                {['Chai Bar Guest', 'ravi@okaxis · ₹150', 'chaibar.in/menu'].map((row) => (
                  <span class="truncate rounded-[10px] bg-[#26221C] px-3 py-2 text-sm">{row}</span>
                ))}
              </span>
            )}
            {tile.id === 'expiry' && (
              <span class="stamp stamp-sm" style="--stamp-tilt:-10deg">
                <span class="stamp-top">CHECKED</span>
                <span class="stamp-main">RENTED</span>
                <span class="stamp-bottom stamp-hi" lang="hi">
                  किराया
                </span>
              </span>
            )}
            {tile.id === 'print' && (
              <span class="grid grid-cols-3 gap-1.5 rounded-[10px] bg-surface-2 p-3">
                {Array.from({ length: 9 }, () => (
                  <span class="flex h-9 w-9 items-center justify-center rounded-[6px] bg-surface">
                    <Icon name="qr" size={22} />
                  </span>
                ))}
              </span>
            )}
            {tile.id === 'batch' && (
              <span class="flex w-full max-w-[340px] flex-col gap-1 font-mono text-[0.75rem]">
                {[
                  'url,filename',
                  'chaibar.in/m/1,table-01',
                  'chaibar.in/m/2,table-02',
                  '… 497 more',
                ].map((row, i) => (
                  <span
                    class:list={[
                      'rounded-[8px] px-3 py-1.5',
                      i === 0 ? 'bg-accent text-accent-contrast' : 'bg-soft',
                    ]}
                  >
                    {row}
                  </span>
                ))}
              </span>
            )}
          </span>
          <span class="text-[1.05rem] leading-snug font-semibold">{t(`bento.${tile.id}`)}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
