---
import type { Faq } from '../../lib/i18n/content';
interface Props {
  title: string;
  faqs: Faq[];
  headingLevel?: 'h2' | 'h3';
}
const { title, faqs, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section class="mx-auto mt-20 max-w-[1360px] px-4 sm:px-8" aria-labelledby="faq-heading">
  <Heading id="faq-heading">{title}</Heading>
  <div class="mt-6 max-w-4xl border-t border-border">
    {faqs.map((f) => (
      <details class="group border-b border-border">
        <summary class="flex min-h-14 items-center justify-between gap-3 py-4 text-[1.15rem] font-semibold">
          <span>{f.q}</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="shrink-0 transition-transform group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <p class="max-w-[68ch] pb-5 text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
