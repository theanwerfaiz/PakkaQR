---
import type { Faq } from '../../lib/i18n/content';
interface Props {
  title: string;
  faqs: Faq[];
  headingLevel?: 'h2' | 'h3';
}
const { title, faqs, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<section class="mx-auto mt-14 max-w-3xl px-4" aria-labelledby="faq-heading">
  <Heading id="faq-heading" class="text-2xl font-bold">
    {title}
  </Heading>
  <div class="mt-5 space-y-3">
    {faqs.map((f) => (
      <details class="card group p-0">
        <summary class="flex min-h-12 items-center justify-between gap-3 px-4 py-3 font-semibold">
          <span>{f.q}</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            aria-hidden="true"
            class="shrink-0 transition-transform group-open:rotate-180"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <p class="px-4 pb-4 text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
