---
import { useContent } from '../../lib/i18n/content';
import type { Locale } from '../../lib/i18n';
interface Props {
  locale: Locale;
}
const c = useContent(Astro.props.locale);
---

<figure class="card grid gap-6 p-5 md:grid-cols-2">
  <div>
    <p class="font-semibold text-success">{c('diagram.staticTitle')}</p>
    <svg viewBox="0 0 320 120" class="mt-3 w-full" role="img" aria-labelledby="diag-static">
      <title id="diag-static">{c('diagram.staticAlt')}</title>
      <rect
        x="8"
        y="30"
        width="60"
        height="60"
        rx="8"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
      ></rect>
      <path d="M20 42h14v14H20zM42 42h14v14H42zM20 64h14v14H20z" fill="currentColor"></path>
      <path d="M80 60h150" stroke="var(--success)" stroke-width="4" marker-end="url(#a1)"></path>
      <defs>
        <marker
          id="a1"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
        >
          <path d="M0 0l10 5-10 5z" fill="var(--success)"></path>
        </marker>
        <marker
          id="a2"
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto"
        >
          <path d="M0 0l10 5-10 5z" fill="var(--danger)"></path>
        </marker>
      </defs>
      <rect
        x="238"
        y="35"
        width="74"
        height="50"
        rx="8"
        fill="var(--success)"
        opacity="0.15"
      ></rect>
      <text
        x="275"
        y="64"
        text-anchor="middle"
        font-size="13"
        font-weight="700"
        fill="currentColor"
      >
        {c('diagram.yourSite')}
      </text>
      <text x="155" y="50" text-anchor="middle" font-size="12" fill="currentColor">
        {c('diagram.direct')}
      </text>
    </svg>
    <figcaption class="mt-2 text-sm text-muted">{c('diagram.staticCaption')}</figcaption>
  </div>
  <div>
    <p class="font-semibold text-danger">{c('diagram.dynamicTitle')}</p>
    <svg viewBox="0 0 320 120" class="mt-3 w-full" role="img" aria-labelledby="diag-dynamic">
      <title id="diag-dynamic">{c('diagram.dynamicAlt')}</title>
      <rect
        x="8"
        y="30"
        width="60"
        height="60"
        rx="8"
        fill="none"
        stroke="currentColor"
        stroke-width="3"
      ></rect>
      <path d="M20 42h14v14H20zM42 42h14v14H42zM20 64h14v14H20z" fill="currentColor"></path>
      <path d="M74 60h52" stroke="var(--danger)" stroke-width="4" marker-end="url(#a2)"></path>
      <rect x="130" y="35" width="74" height="50" rx="8" fill="var(--danger)" opacity="0.15"></rect>
      <text
        x="167"
        y="58"
        text-anchor="middle"
        font-size="12"
        font-weight="700"
        fill="currentColor"
      >
        {c('diagram.theirServer')}
      </text>
      <text x="167" y="74" text-anchor="middle" font-size="11" fill="currentColor">
        {c('diagram.trialEnds')}
      </text>
      <path
        d="M208 60h24"
        stroke="var(--danger)"
        stroke-width="4"
        stroke-dasharray="5 5"
        marker-end="url(#a2)"
      ></path>
      <rect
        x="238"
        y="35"
        width="74"
        height="50"
        rx="8"
        fill="none"
        stroke="currentColor"
        stroke-dasharray="4 4"
      ></rect>
      <text
        x="275"
        y="64"
        text-anchor="middle"
        font-size="13"
        font-weight="700"
        fill="currentColor"
      >
        {c('diagram.yourSite')}
      </text>
    </svg>
    <figcaption class="mt-2 text-sm text-muted">{c('diagram.dynamicCaption')}</figcaption>
  </div>
</figure>
