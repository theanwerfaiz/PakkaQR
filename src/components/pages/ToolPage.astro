---
import HowTo from '../content/HowTo.astro';
import FaqList from '../content/FaqList.astro';
import RelatedLinks from '../content/RelatedLinks.astro';
import Batch from '../batch/Batch';
import Scanner from '../scanner/Scanner';
import ExpiryChecker from '../expiry/ExpiryChecker';
import Print from '../print/Print';
import BarcodeTool from '../tools/BarcodeTool';
import Templates from '../tools/Templates';
import SecretNote from '../tools/SecretNote';
import OpenNote from '../tools/OpenNote';
import PhotoQr from '../tools/PhotoQr';
import type { PageDef } from '../../data/pages';
import { getTranslator, type Locale } from '../../lib/i18n';
import { contentList, useContent, type Faq } from '../../lib/i18n/content';

interface Props {
  locale: Locale;
  page: PageDef;
}
const { locale, page } = Astro.props;
const c = useContent(locale);
const t = getTranslator(locale);
const k = (key: string) => `pages.${page.key}.${key}`;
const steps = contentList(locale, k('steps'));
const faqs = contentList<Faq>(locale, k('faq'));
const paragraphs = contentList(locale, k('body'));
---

<section class="mx-auto max-w-[1360px] px-4 pt-10 pb-8 sm:px-8 sm:pt-14">
  <p class="kicker">{t('hero.kicker')}</p>
  <h1 class="mt-4 max-w-[18ch]">{c(k('h1'))}</h1>
  <p class="mt-5 max-w-[52ch] text-[1.2rem] text-muted">{c(k('intro'))}</p>
</section>

<section class="mx-auto max-w-[1360px] px-4 sm:px-8" aria-label={c(k('h1'))}>
  {page.kind === 'batch' && <Batch client:load locale={locale} />}
  {page.kind === 'scanner' && <Scanner client:load locale={locale} />}
  {page.kind === 'expiry' && <ExpiryChecker client:load locale={locale} />}
  {page.kind === 'print' && <Print client:load locale={locale} />}
  {page.kind === 'barcode' && <BarcodeTool client:load locale={locale} />}
  {page.kind === 'templates' && <Templates client:load locale={locale} />}
  {page.kind === 'secret' && <SecretNote client:load locale={locale} />}
  {page.kind === 'open' && <OpenNote client:load locale={locale} />}
  {page.kind === 'photo' && <PhotoQr client:load locale={locale} />}
</section>

{paragraphs.length > 0 && (
  <section class="prose-pakka mx-auto mt-20 max-w-[1360px] px-4 sm:px-8">
    <h2>{c(k('bodyTitle'))}</h2>
    {paragraphs.map((p) => (
      <p>{p}</p>
    ))}
  </section>
)}

{steps.length > 0 && <HowTo title={c(k('howToTitle'))} steps={steps} />}
{faqs.length > 0 && <FaqList title={c(k('faqTitle'))} faqs={faqs} />}
<RelatedLinks locale={locale} slugs={page.related} title={c('common.related')} />
