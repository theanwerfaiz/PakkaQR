---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localePath } from '../lib/i18n';
import { useContent } from '../lib/i18n/content';

const c = useContent('en');
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  locale="en"
  slug="404"
  title={c('pages.notFound.title')}
  description={c('pages.notFound.description')}
  noindex
  alternates={false}
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-20 text-center">
    <div class="stamp" data-status="fail" aria-hidden="true">
      <span class="stamp-top">NOT</span>
      <span class="stamp-main">404</span>
      <span class="stamp-bottom">FOUND</span>
    </div>
    <h1 class="mt-8 !text-[clamp(2.25rem,1.6rem+2.5vw,3.75rem)]">{c('pages.notFound.h1')}</h1>
    <p class="mt-3 text-muted">{c('pages.notFound.intro')}</p>
    <p class="mt-6 flex flex-wrap justify-center gap-3">
      <a class="btn btn-primary" href={localePath('en', '', base)}>
        {c('pages.notFound.home')}
      </a>
      <a class="btn btn-secondary" href={localePath('hi', '', base)} lang="hi">
        {c('pages.notFound.homeHi')}
      </a>
    </p>
  </section>
</BaseLayout>
